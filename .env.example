# IPv4-safe Supabase pooler URL (used by app runtime and Prisma CLI in this setup)
# Prisma config will automatically enforce:
# - pgbouncer=true
# - statement_cache_size=0
DATABASE_URL="postgresql://USER:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&statement_cache_size=0"

# Optional explicit migration URL (also should be pooler URL for IPv4-only environments)
# MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&statement_cache_size=0"
