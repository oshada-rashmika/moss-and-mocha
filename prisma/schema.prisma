// This technical stack utilizes NestJS, Prisma, and PostgreSQL via Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MainCategory {
  BREWS
  BOTANICALS
  AESTHETIC_LABELS
  BARISTA_CLASSICS
}

enum OrderStatus {
  PENDING
  SUCCESS
  BREWING
  READY
}

model Product {
  id           String       @id @default(uuid())
  name         String
  price        Float
  image        String       // Placeholder image URL
  mainCategory MainCategory
  subCategory  String       // e.g., "Pacific Cold Brews" or "Mocha"
  isSpecial    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Order {
  id        String      @id @default(uuid())
  status    OrderStatus @default(PENDING)
  total     Float       @default(0.0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}