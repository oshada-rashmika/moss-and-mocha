generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Note: url is managed in prisma.config.ts for Prisma 7+
}

enum MainCategory {
  BREWS
  BOTANICALS
  AESTHETIC_LABELS
  BARISTA_CLASSICS
  BOBA
}

enum OrderStatus {
  PENDING
  SUCCESS
  BREWING
  READY
}

model Product {
  id           String       @id @default(uuid())
  name         String
  price        Float
  image        String
  mainCategory MainCategory
  subCategory  String
  isSpecial    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
}

model Order {
  id        String      @id @default(uuid())
  status    OrderStatus @default(PENDING)
  total     Float       @default(0.0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  name      String
  rating    Int      @default(5)
  comment   String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}